# Copy to .env (gitignored) and fill in.
# Single .env at repo root; loaded by both backend (pydantic-settings) and frontend (Next.js).

# Supabase — get from https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend mirrors of the above (Next.js requires NEXT_PUBLIC_ prefix for client-side access)
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}

# Anthropic API key — only needed for M3 (constraint parsing) and M4 (DARS extraction)
ANTHROPIC_API_KEY=
